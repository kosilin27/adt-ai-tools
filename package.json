{
  "name": "adt-ai-tools-catalog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "npm run test:figma-sync && npm run test:mcp-startup && npm run build && npm run verify:figma-parity && playwright test",
    "verify:figma-parity": "node --experimental-strip-types scripts/verify-figma-parity.mjs",
    "verify:remote": "node scripts/verify-remote.mjs",
    "sync:figma": "node --experimental-strip-types scripts/sync-figma.mjs",
    "check:figma-live": "node --experimental-strip-types scripts/sync-figma.mjs --check",
    "test:figma-sync": "node --experimental-strip-types scripts/test-figma-live.mjs",
    "sync:confluence": "node --experimental-strip-types scripts/confluence/sync.mjs",
    "check:confluence": "node --experimental-strip-types scripts/confluence/sync.mjs",
    "verify:ci": "npm run verify",
    "test:mcp-startup": "node scripts/test-mcp-startup.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
